# =============================================================================
# Stoop. Environment variables.
# Copy this file to `.env.local` and fill in the values for local development.
# Never commit `.env.local`.
# =============================================================================

# --- Site -------------------------------------------------------------------

# The public URL of your deployment. Used in emails and OG metadata.
# Local: http://localhost:3000
# Preview: https://your-branch--stoop.vercel.app
# Production: https://stoop.app (or whatever domain we land on)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Supabase ---------------------------------------------------------------
# Find these in your Supabase project: Settings → API
#   - URL is "Project URL"
#   - Anon key is the anon/public key
#   - Service role key is the secret key (NEVER expose to the browser)

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"


# --- Database ---------------------------------------------------------------
# Direct connection string for Drizzle migrations + queries.
#
# IMPORTANT for Vercel: use the *pooler* (port 6543) URL in production so that
# serverless functions don't exhaust the connection pool. Locally either works.
#
# Format:
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Find this in: Supabase → Project Settings → Database → Connection string

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"


# --- Resend (transactional email) ------------------------------------------
# Get a free API key from https://resend.com

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# "From" address for waitlist/auth emails. Must be a verified domain on Resend.
# Until DNS is set up, use the Resend sandbox: onboarding@resend.dev
EMAIL_FROM="Stoop <hello@stoop.app>"


# --- Mapbox (optional in v0.1; required for distance-ranked reviews) -------

NEXT_PUBLIC_MAPBOX_TOKEN=""


# --- PostHog (optional analytics) ------------------------------------------
# Get a free project at https://posthog.com

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"


# --- Stripe (planned for v0.2, escrow) --------------------------------------
# Leave blank for v0.1.

# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
